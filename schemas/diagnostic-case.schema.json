{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hvac-xpert.local/diagnostic-case.schema.json",
  "title": "Diagnostic Case Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "model_id",
    "revision_id",
    "knowledge_package_ids",
    "path_id",
    "mode",
    "state",
    "complaint_summary",
    "fault_codes",
    "safety_acknowledged",
    "current_step_id",
    "results",
    "evaluation",
    "disposition",
    "guidance",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "case_id": {"$ref": "common.schema.json#/$defs/entityId"},
    "model_id": {"$ref": "common.schema.json#/$defs/entityId"},
    "revision_id": {"$ref": "common.schema.json#/$defs/entityId"},
    "knowledge_package_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/entityId"}
    },
    "path_id": {"$ref": "common.schema.json#/$defs/entityId"},
    "mode": {"type": "string", "enum": ["FIELD", "TRAINING"]},
    "state": {
      "type": "string",
      "enum": [
        "SAFETY_ACKNOWLEDGEMENT_REQUIRED",
        "AWAITING_RESULT",
        "NEXT_TEST_AVAILABLE",
        "COMPLETE",
        "ESCALATION_REQUIRED",
        "STOPPED"
      ]
    },
    "complaint_summary": {"type": "string", "minLength": 1},
    "fault_codes": {"$ref": "common.schema.json#/$defs/stringArray"},
    "safety_acknowledged": {"type": "boolean"},
    "current_step_id": {"$ref": "common.schema.json#/$defs/nullableNonEmptyString"},
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    },
    "evaluation": {
      "oneOf": [
        {"$ref": "#/$defs/evaluation"},
        {"type": "null"}
      ]
    },
    "disposition": {
      "type": ["string", "null"],
      "enum": ["NEXT_TEST", "COMPLETE", "ESCALATE", "STOP", null]
    },
    "guidance": {"$ref": "common.schema.json#/$defs/nullableString"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "step_id",
        "measurement_id",
        "source_type",
        "result_kind",
        "numeric_value",
        "qualitative_value",
        "unit",
        "recorded_by",
        "recorded_at",
        "notes"
      ],
      "properties": {
        "result_id": {"$ref": "common.schema.json#/$defs/entityId"},
        "step_id": {"$ref": "common.schema.json#/$defs/entityId"},
        "measurement_id": {"$ref": "common.schema.json#/$defs/entityId"},
        "source_type": {"type": "string", "enum": ["TECHNICIAN_ENTRY", "IMPORTED", "SIMULATED"]},
        "result_kind": {"type": "string", "enum": ["NUMERIC", "QUALITATIVE"]},
        "numeric_value": {"type": ["number", "null"]},
        "qualitative_value": {
          "type": ["string", "null"],
          "enum": ["CONTINUITY", "NO_CONTINUITY", "OPEN", "CLOSED", "PRESENT", "ABSENT", "OTHER", "UNKNOWN", null]
        },
        "unit": {"$ref": "common.schema.json#/$defs/nullableNonEmptyString"},
        "recorded_by": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "notes": {"$ref": "common.schema.json#/$defs/nullableString"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "measurement_id", "outcome", "branch_id"],
      "properties": {
        "step_id": {"$ref": "common.schema.json#/$defs/entityId"},
        "measurement_id": {"$ref": "common.schema.json#/$defs/entityId"},
        "outcome": {
          "type": "string",
          "enum": ["MATCHES_EXPECTED", "DOES_NOT_MATCH_EXPECTED", "UNKNOWN"]
        },
        "branch_id": {"$ref": "common.schema.json#/$defs/entityId"}
      }
    }
  }
}

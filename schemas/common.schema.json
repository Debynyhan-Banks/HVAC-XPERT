{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hvac-xpert.local/common.schema.json",
  "title": "HVAC XPERT Common Definitions",
  "$defs": {
    "entityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "nullableNonEmptyString": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "nullableDate": {
      "oneOf": [
        {"type": "string", "format": "date"},
        {"type": "null"}
      ]
    },
    "nullableDateTime": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "validationLevel": {
      "type": "string",
      "enum": [
        "LEVEL_0_UNKNOWN",
        "LEVEL_1_AI_EXTRACTED",
        "LEVEL_2_SOURCE_VISIBLE",
        "LEVEL_3_CROSS_SOURCE_CONFIRMED",
        "LEVEL_4_TECHNICIAN_REVIEWED",
        "LEVEL_5_INSTRUCTOR_VALIDATED",
        "LEVEL_6_MANUFACTURER_VERIFIED"
      ]
    },
    "reviewOutcome": {
      "type": "string",
      "enum": ["PENDING", "ACCEPTED", "REVISED", "REJECTED", "CONFLICTED"]
    },
    "provenanceArray": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "provenance.schema.json"}
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entityId"}
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "quantifiedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"$ref": "#/$defs/nullableNonEmptyString"},
        "tolerance": {"type": ["number", "null"], "minimum": 0},
        "notes": {"$ref": "#/$defs/nullableString"}
      }
    }
  }
}
